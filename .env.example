# CloudHosting AI Panel: runtime environment. The real .env is gitignored.
# On the OpenClaw and Hermes VMs these values are set in docker-compose.yml.

# Which product this panel instance manages (selects adapters/<product>.js):
#   openclaw | hermes | flowise | langflow | dify
PRODUCT=hermes

# Port the panel listens on inside the container (Caddy fronts it on :8443).
PANEL_PORT=8080

# Login. The user name defaults to admin. Without PANEL_PASSWORD the panel
# refuses to start (PANEL_ALLOW_OPEN=1 allows a run without login, local testing only).
PANEL_PASSWORD=

# Public hostname, vps-<3rd octet>-<4th octet>.cloudhosting.lv (derived from the
# VM IP), e.g. vps-12-34.cloudhosting.lv. Used for the Connect Avots callback URL
# and for builder "Open product" links.
PANEL_DOMAIN=

# Optional Avots API key. On startup the panel connects Avots as the primary AI
# if no other primary is set (idempotent). Leave blank to let the user pick a
# provider in the UI.
AVOTS_API_KEY=

# hermes adapter: the shared data dir the agent reads (config.yaml + .env).
# In the hermes-vm compose the panel mounts ./data at /data, so set this to /data.
HERMES_DATA_DIR=/data

# openclaw adapter: the shared data dir the gateway reads (openclaw.json + .env).
OPENCLAW_DATA_DIR=/data
